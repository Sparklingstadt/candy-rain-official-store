POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:pass@localhost:5432/candyrain"
AUTH_SECRET="replace-with-a-random-secret"
# Optional: `npm run db:seed` creates the admin@mail.com admin account with this
# password (12+ characters). Leave empty to seed no admin, e.g. for a public demo.
SEED_ADMIN_PASSWORD=""
# Optional: Stripe test-mode keys enable saving cards and card payment at checkout.
# Leave empty to place orders without payment. Live keys are rejected.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Candy Rain ID (candy-rain-identity-server) handles sign-in. With a localhost
# issuer, `npm run dev` starts it for you with `go run` (Go 1.26 or later).
AUTH_CANDY_RAIN_ID_ISSUER="http://localhost:8080"
AUTH_CANDY_RAIN_ID_ID="candy-rain-store"
AUTH_CANDY_RAIN_ID_SECRET="local-dev-client-secret"
