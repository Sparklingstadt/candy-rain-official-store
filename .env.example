POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:pass@localhost:5432/candyrain"
AUTH_SECRET="replace-with-a-random-secret"
# Optional: Stripe test-mode keys enable saving cards and card payment at checkout.
# Leave empty to place orders without payment. Live keys are rejected.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional: Candy Rain ID (candy-rain-identity-server). Set all three to show
# "Candy Rain ID でサインイン". Register <store origin>/api/auth/callback/candy-rain-id
# as the redirect URI and <store origin>/signout as the post-logout redirect URI there.
AUTH_CANDY_RAIN_ID_ISSUER=""
AUTH_CANDY_RAIN_ID_ID=""
AUTH_CANDY_RAIN_ID_SECRET=""
