// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  // The shipping address is optional until the user registers one.
  postalCode String?
  prefecture String?
  addressLine1 String?
  addressLine2 String?
  // Saved cards live in Stripe; only the customer reference is stored here.
  stripeCustomerId String? @unique
  orders Order[]
  carts Cart[]
}

model Product {
  id Int @id @default(autoincrement())
  name String
  category String?
  salesType SalesType @default(PERMANENT)
  description String
  variants Variant[]
  thumbnailImageUrl String
}

enum SalesType {
  PRE_SALE
  MADE_TO_ORDER
  POST_EVENT
  PERMANENT
}

model Variant {
  id Int @id @default(autoincrement())
  name String
  product Product @relation(fields: [productId], references: [id])
  productId Int
  price Int
  stock Int
  imageUrl String
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Order {
  id Int @id @default(autoincrement())
  paymentStatus String
  shippingStatus String
  shippingPrice Int
  totalPrice Int
  // Set when the order was paid with a saved card through Stripe.
  paymentIntentId String? @unique
  paymentMethodLabel String?
  orderedAt DateTime @default(now())
  orderItems OrderItem[]
  user User @relation(fields: [userId], references: [id])
  userId Int
}

model OrderItem {
  id Int @id @default(autoincrement())
  order Order @relation(fields: [orderId], references: [id])
  orderId Int
  variant Variant @relation(fields: [variantId], references: [id])
  variantId Int
  variantName String
  priceAtPurchase Int
  quantity Int
}

model Cart {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int @unique
  items CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())
  cart Cart @relation(fields: [cartId], references: [id])
  cartId Int
  variant Variant @relation(fields: [variantId], references: [id])
  variantId Int
  quantity Int
  @@unique([cartId, variantId])
}
